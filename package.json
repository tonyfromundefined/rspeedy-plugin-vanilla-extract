{
  "name": "rspeedy-plugin-vanilla-extract",
  "version": "0.2.0",
  "description": "vanilla-extract integration for Rspeedy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyfromundefined/rspeedy-plugin-vanilla-extract.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bunchee",
    "dev": "bunchee --watch",
    "typecheck": "tsc --noEmit",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@vanilla-extract/webpack-plugin": "^2.3.26"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@rsbuild/core": "^1",
    "bunchee": "^6.9.3",
    "typescript": "^5.9.3",
    "webpack": "^5.105.4"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1",
    "webpack": "^5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "yarn@4.18.0"
}
